{
  "identifier": "titlebar",
  "description": "Local custom window controls",
  "platforms": [
    "windows",
    "linux"
  ],
  "windows": [
    "main",
    "settings",
    "document-*",
    "quick",
    "quick-*"
  ],
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-close"
  ]
}
