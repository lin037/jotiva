{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jotiva",
  "version": "0.2.0",
  "identifier": "io.github.lin037.jot.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http: https:; object-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/lin037/jotiva/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": ["notices/"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "contentTypes": ["net.daringfireball.markdown"],
        "mimeType": "text/markdown",
        "name": "Markdown",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["txt"],
        "contentTypes": ["public.plain-text"],
        "mimeType": "text/plain",
        "name": "Plain Text",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "installer/install.png",
        "windowSize": { "width": 576, "height": 318 },
        "appPosition": { "x": 160, "y": 112 },
        "applicationFolderPosition": { "x": 416, "y": 112 }
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"]
  }
}
